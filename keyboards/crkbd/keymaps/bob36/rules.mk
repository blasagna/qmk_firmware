# To disable Underglow:
RGBLIGHT_ENABLE = no

# To disable RGB Matrix (Per-key and typically all lights on Corne):
RGB_MATRIX_ENABLE = no

MOUSEKEY_ENABLE = yes

# Report key-down instantly; debounce only on release (default is sym_defer_g,
# which delays every press by DEBOUNCE ms).
DEBOUNCE_TYPE = asym_eager_defer_pk

LTO_ENABLE = yes

BOOTLOADER = atmel-dfu
